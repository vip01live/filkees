{
  "project": {
    "name": "YvnBet",
    "type": "Online Casino Frontend Website",
    "version": "1.0.0",
    "description": "A modern, premium online casino website with a dark luxury aesthetic. The brand name is YvnBet. Never mention any third-party provider. The site is presented as YvnBet's own platform. All operations (registration, deposit, withdrawal) happen via Telegram. Code must look like it was written by a senior frontend engineer with 10+ years of experience — clean, modular, zero AI fingerprints, zero leftover comments like 'generated by'.",
    "tagline": {
      "hy": "Խաղա՛ վստահ, հաղթի՛ր YVNBET-ի հետ։",
      "ru": "Играй уверенно, побеждай вместе с YVNBET.",
      "en": "Play with confidence, win with YVNBET."
    },
    "domain_notes": "Login iframe loads https://ggplus.pro under the site's own domain. Never display that URL to the user. Never mention a provider anywhere in UI, meta, or comments."
  },

  "tech_stack": {
    "html": "HTML5 semantic",
    "css": "Separate file: /assets/css/main.css — CSS custom properties, keyframes, no inline styles except dynamic JS-injected ones",
    "js": "Separate files under /assets/js/ — vanilla JS, no jQuery, no unnecessary libraries",
    "structure": [
      "/index.html",
      "/login/index.html",
      "/about/index.html",
      "/terms/index.html",
      "/privacy/index.html",
      "/contact/index.html",
      "/responsible/index.html",
      "/partners/index.html",
      "/assets/css/main.css",
      "/assets/css/pages.css",
      "/assets/js/core.js",
      "/assets/js/i18n.js",
      "/assets/js/slider.js",
      "/assets/js/jackpot.js",
      "/assets/js/audio.js",
      "/assets/js/age-gate.js",
      "/assets/js/telegram-fab.js",
      "/assets/js/admin.js",
      "/assets/data/content.json",
      "/assets/data/games.json",
      "/assets/data/jackpots.json",
      "/assets/img/",
      "/assets/icons/",
      "/assets/audio/bg.mp3",
      "/assets/fonts/"
    ],
    "no_inline_code_in_html": true,
    "compatibility": "All modern browsers, iOS Safari, Android Chrome, tablets, desktops. Progressive enhancement. No layout break below 320px."
  },

  "design_system": {
    "philosophy": "Luxury dark casino. Purple neon on deep violet-black. Generous whitespace. Nothing cluttered. Every block has a clear purpose. Looks like a top-tier product designer shipped it.",
    "colors": {
      "header": "#9A24AD",
      "background": "#1D052C",
      "surface": "#2A0A3D",
      "surface_alt": "#3B1054",
      "accent": "#C84DFF",
      "accent_hover": "#E08CFF",
      "gold": "#F5C542",
      "text": "#F4E8FF",
      "text_muted": "#B89BC9",
      "success": "#2EE59D",
      "danger": "#FF4D6D",
      "border": "rgba(200, 77, 255, 0.25)"
    },
    "typography": {
      "logo": "Unique display font, letter-spacing 0.08em, gradient fill #E08CFF → #F5C542, no image logo, text-only 'YvnBet'",
      "headings": "Modern geometric sans (e.g. Outfit / Clash Display style via @font-face)",
      "body": "Clean readable sans (e.g. Manrope)",
      "numbers": "Tabular nums for jackpots and amounts"
    },
    "logo": {
      "type": "SVG text wordmark, vector, memorable",
      "content": "YvnBet",
      "placement": "Header left",
      "no_external_brand_marks": true
    },
    "icons": "SVG icons only. Never emojis. Payment, social, UI, footer — all SVG.",
    "radius": "14px cards, 999px pills/buttons",
    "shadows": "Soft violet glows, not heavy black drop-shadows",
    "motion": {
      "engine": "CSS @keyframes + modest JS",
      "feel": "Smooth, 200–400ms, cubic-bezier(0.22, 1, 0.36, 1)",
      "examples": [
        "header fade-in on load",
        "slider ken-burns on images",
        "button ripple / glow pulse",
        "jackpot row slide-up",
        "FAB telegram float + subtle bounce",
        "age-gate scale-in",
        "card hover lift + border glow",
        "language dropdown slide"
      ]
    }
  },

  "restrictions": {
    "disable_zoom": "viewport maximum-scale=1, user-scalable=no, plus gesture listeners that prevent pinch-zoom",
    "disable_copy": "user-select: none on body; prevent contextmenu; prevent Ctrl/Cmd+C, Ctrl+U, Ctrl+S, F12, Ctrl+Shift+I — do not break form inputs in admin",
    "no_ai_tone_copy": "All visible texts written as a real casino copywriter. Short, confident, no filler, no 'professional gaming platform' phrases, no 'multilingual support' announcements on the public site.",
    "forbidden_on_public_pages": [
      "Any mention of a provider",
      "Any mention that the site is multilingual as a selling point",
      "Terms, privacy, partner program body text dumped on the homepage",
      "Clutter, walls of text, emoji"
    ]
  },

  "i18n": {
    "languages": ["hy", "ru", "en"],
    "default": "hy",
    "geo_detect": "On first visit detect region (navigator + optional IP hint). AM → hy, RU/BY/KZ/KG/UZ → ru, else en. Persist in localStorage.",
    "switcher": {
      "placement": "Header, left of auth buttons",
      "ui": "Current language code button. Click opens compact dropdown (HY / RU / EN). No sentence like 'we support 3 languages' anywhere."
    },
    "all_ui_strings": "Loaded from /assets/data/content.json so admin can edit every label, button, SEO text, page body."
  },

